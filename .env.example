# Django secret key - generate a real one for anything beyond local dev, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=True

# Base URL this server is reachable at (used in API docs / links only).
API_URL=http://localhost:8002

# Optional: only needed for the Instagram-reel location-extraction feature
# (apps/core/instagram/analyzer.py), which calls the Gemini API. Everything
# else (auth, saved locations) works without it.
GOOGLE_API_KEY=

# Optional path to a Netscape-format cookies.txt exported from a logged-in
# Instagram session (e.g. with a browser extension like "Get cookies.txt").
# Reel analysis works anonymously for a good share of public reels without
# this, but a logged-in session is much more reliable - and without either
# this or GOOGLE_API_KEY, reel analysis just returns "add manually", and the
# app still works fine for manually saved/searched locations.
INSTAGRAM_YTDLP_COOKIES_FILE=
