# Memory Map backend configuration. Copy to .env for local development;
# in production set these as environment variables on your host.
# Only SECRET_KEY, ALLOWED_HOSTS and PUBLIC_BASE_URL are required in production.

# --- Core ---------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Never True in production.
DEBUG=True
# Comma-separated hostnames this server answers to, e.g. api.memorymap.app
ALLOWED_HOSTS=
# The public https:// address of this server. Used in password-reset emails
# and as the default CSRF trusted origin.
PUBLIC_BASE_URL=http://localhost:8002
# Obscure the admin path, e.g. manage-3f9a/  (must end with a slash)
ADMIN_URL=admin/
# Set to the number of reverse proxies in front of the app (1 on most PaaS
# hosts) so rate limits see the real client IP.
NUM_PROXIES=0

# --- Database & cache ---------------------------------------------------
# Postgres in production. Unset = local SQLite file (development only).
# DATABASE_URL=postgres://memorymap:memorymap@localhost:5432/memorymap
DB_CONN_MAX_AGE=60
# Needed whenever more than one server process runs, so rate limits are shared.
# REDIS_URL=redis://localhost:6379/0

# --- Email (password reset) ---------------------------------------------
# Unset EMAIL_HOST = emails are printed to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Memory Map <no-reply@example.com>
# Shown on the privacy policy, terms and error pages.
SUPPORT_EMAIL=support@example.com

# --- Reel analysis (optional) -------------------------------------------
# Without a Gemini key, sharing a reel still works: the app goes straight to
# manual search. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REEL_ANALYSIS_ENABLED=True
# Netscape-format cookies.txt from a logged-in Instagram session. Optional,
# but makes reading reel captions far more reliable.
INSTAGRAM_YTDLP_COOKIES_FILE=

# --- Place search -------------------------------------------------------
# Photon (OpenStreetMap). The public instance is fine to start with; for
# heavy traffic, self-host Photon or use a commercial Photon-compatible API.
GEOCODER_BASE_URL=https://photon.komoot.io
GEOCODER_CACHE_SECONDS=604800

# --- Tuning (defaults are sensible) --------------------------------------
# API_DOCS_ENABLED=False        # /api/docs/ - on by default only when DEBUG
# CORS_ALLOWED_ORIGINS=         # only needed for browser clients
# CSRF_TRUSTED_ORIGINS=
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=30
# THROTTLE_ANON=60/min
# THROTTLE_USER=300/min
# THROTTLE_AUTH=10/min
# THROTTLE_REEL_ANALYSIS=30/hour
# THROTTLE_GEOCODE=60/min
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# LOG_LEVEL=INFO
