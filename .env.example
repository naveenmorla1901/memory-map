# Django secret key - generate a real one for anything beyond local dev, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=True

# Base URL this server is reachable at (used in API docs / links only).
API_URL=http://localhost:8002

# Optional: only needed for the Instagram-reel location-extraction feature
# (apps/core/instagram/analyzer.py), which calls the Gemini API. Everything
# else (auth, saved locations) works without it.
GOOGLE_API_KEY=
