# Django secret key - generate a real one for anything beyond local dev, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=True

# Base URL this server is reachable at (used in API docs / links only).
API_URL=http://localhost:8002

# Optional: only needed for the Instagram-reel location-extraction feature
# (apps/core/instagram/analyzer.py), which calls the Gemini API. Everything
# else (auth, saved locations) works without it.
GOOGLE_API_KEY=

# Optional: a Meta developer app access token ("{app-id}|{client-token}") with
# the oEmbed Read permission (requires Meta App Review) for reliably reading a
# reel's caption. Without this, the app falls back to scraping the reel page
# directly, which Instagram blocks for unauthenticated requests - so without
# either of the above two vars, reel analysis returns "add manually" and the
# app still works fine for manually saved/searched locations.
INSTAGRAM_OEMBED_ACCESS_TOKEN=
